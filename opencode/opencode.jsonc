{
    "$schema": "https://opencode.ai/config.json",
    "autoupdate": false,
    "model": "ollama/deepseek-v4.1-flash:cloud",
    "permission": {
        "bash": {
            "sudo *": "ask",
            "rm -rf *": "deny",
            "git commit *": "ask",
            "git push *": "deny",
            "git reset --hard*": "deny",
            "git clean *": "deny",
            "git filter-branch *": "deny",
            "git update-ref *": "deny",
            "git branch -D *": "deny",
            "git * commit *": "ask",
            "git * push *": "deny",
            "git * reset --hard*": "deny",
            "git * clean *": "deny",
            "git * filter-branch *": "deny",
            "git * update-ref *": "deny",
            "git * branch -D *": "deny"
        },
        "read": {
            "~/.bashrc": "deny",
            "~/.zshrc": "deny",
            "~/.bash*": "deny",
            "~/.zsh*": "deny",
            ".env": "deny",
            ".env.*": "deny",
            "secrets/**": "deny"
        },
        "external_directory": {
            "/tmp/**": "allow"
        }
    },
    "agent": {
        "build": {
            "permission": {
                "task": {
                    "*": "allow",
                    "recruiter": "deny",
                    "harness-engineer": "deny",
                    "ai": "deny",
                    "plan": "deny",
                    "hr": "deny"
