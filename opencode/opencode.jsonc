                    "build": "deny",
                    "plan": "deny",
                    "hr": "deny"
                }
            }
        },
        "ai": {
            "permission": {
                "task": {
                    "*": "allow",
                    "architect": "deny",
                    "challenger": "deny",
                    "code-reviewer": "deny",
                    "debugger": "deny",
                    "firmware-engineer": "deny",
                    "python-engineer": "deny",
                    "security-reviewer": "deny",
