    "lsp": true,
    "compaction": {
        "auto": true,
        "prune": true,
        "reserved": 20000
    },
    "provider": {
        "ollama": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Ollama (NAS)",
            "options": {
                "baseURL": "http://10.31.1.9:30068/v1"
            },
            "models": {
